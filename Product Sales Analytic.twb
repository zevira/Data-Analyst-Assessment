            <column caption='Transaction Date' datatype='date' name='[transaction_date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_1047649903966543873]' derivation='Year' name='[yr:Calculation_1047649903966543873:ok]' pivot='key' type='ordinal' />
