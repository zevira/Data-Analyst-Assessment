    <worksheet name='Total_Daily_Sales'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontsize='22'>Total Daily Sales</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sheet1 (sales_trends)' name='federated.1uf8g0b0kvwa7n1dgx36r0xlivfg' />
          </datasources>
          <datasource-dependencies datasource='federated.1uf8g0b0kvwa7n1dgx36r0xlivfg'>
            <column caption='Transaction_Date(YYYY)' datatype='date' datatype-customized='true' name='[Calculation_1047649903966543873]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='MAKEDATE(YEAR([transaction_date]), 1, 1)' />
            </column>
            <column caption='Week of Month_Transaction Date' datatype='string' name='[Calculation_1047649903967285250]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;Week &quot; + STR(INT((DAY([transaction_date]) - 1) / 7) + 1)' />
            </column>
            <column caption='Month of Transaction Date' datatype='string' name='[Calculation_1047649903967752195]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;month&apos;, [transaction_date])' />
            </column>
            <column-instance column='[Calculation_1047649903967285250]' derivation='None' name='[none:Calculation_1047649903967285250:nk]' pivot='key' type='nominal' />
